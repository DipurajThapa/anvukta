// Anvukta Consulting Service — data model
// Datasource: SQLite (file-based). See README for switching to PostgreSQL.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

/// Admin users who can manage Insights articles and contact submissions.
model User {
  id           String    @id @default(uuid())
  email        String    @unique
  name         String
  passwordHash String
  role         String    @default("admin")
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  posts    Post[]
  sessions Session[]

  @@map("users")
}

/// Server-side session records. The cookie carries only an opaque, hashed token.
model Session {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

/// Insights taxonomy.
model Category {
  id          String   @id @default(uuid())
  name        String   @unique
  slug        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  posts Post[]

  @@map("categories")
}

model Tag {
  id        String   @id @default(uuid())
  name      String   @unique
  slug      String   @unique
  createdAt DateTime @default(now())

  posts PostTag[]

  @@map("tags")
}

/// Join table — explicit so it can carry ordering later without a migration break.
model PostTag {
  postId String
  tagId  String

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  tag  Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([postId, tagId])
  @@index([tagId])
  @@map("post_tags")
}

/// Insights article. Only status = "published" is publicly readable.
model Post {
  id             String    @id @default(uuid())
  title          String
  slug           String    @unique
  excerpt        String
  content        String
  /// An image or a video file. See src/components/insights/ArticleMedia.tsx.
  heroImage      String?
  heroImageAlt   String?
  /// Still frame for a banner video. Ignored when heroImage is an image.
  heroPoster     String?
  status         String    @default("draft")
  publishedAt    DateTime?
  readingMinutes Int       @default(1)
  seoTitle       String?
  seoDescription String?
  canonicalUrl   String?
  ogImage        String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  authorId String?
  author   User?   @relation(fields: [authorId], references: [id], onDelete: SetNull)

  tags PostTag[]

  @@index([status, publishedAt])
  @@index([categoryId])
  @@map("posts")
}

/// Contact submissions from /contact. Never publicly readable.
model ContactSubmission {
  id              String   @id @default(uuid())
  name            String
  email           String
  company         String
  jobTitle        String?
  phone           String?
  serviceInterest String?
  message         String
  consent         Boolean  @default(false)
  status          String   @default("new")
  source          String   @default("website")
  ipHash          String?
  userAgent       String?
  notifiedAt      DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([status, createdAt])
  @@index([email])
  @@map("contact_submissions")
}

/// Durable rate-limit counters, so limits survive a process restart
/// and stay correct for the single-instance deployment target.
model RateLimit {
  id        String   @id @default(uuid())
  key       String   @unique
  count     Int      @default(0)
  expiresAt DateTime

  @@index([expiresAt])
  @@map("rate_limits")
}

/// A chat conversation. Answers come from retrieval over our own content; a
/// person can take the conversation over at any point.
model ChatConversation {
  id          String    @id @default(uuid())
  /// Opaque handle held by the browser so a visitor can return to their thread.
  token       String    @unique
  status      String    @default("bot")
  /// Set when the visitor asks for a person, or when retrieval keeps failing.
  escalatedAt DateTime?
  /// Given only if the visitor offers it, so a person can reply by email.
  name        String?
  email       String?
  ipHash      String?
  userAgent   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  messages ChatMessage[]

  @@index([status, updatedAt])
  @@map("chat_conversations")
}

/// One turn. `role` is visitor, bot or human.
model ChatMessage {
  id             String   @id @default(uuid())
  conversationId String
  role           String
  body           String
  /// Where a bot answer came from, so every claim is traceable to a page.
  sourceHref     String?
  sourceTopic    String?
  /// Marks a bot turn that admitted it did not know.
  unanswered     Boolean  @default(false)
  readByVisitor  Boolean  @default(false)
  createdAt      DateTime @default(now())

  conversation ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("chat_messages")
}
