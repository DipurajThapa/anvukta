# =============================================================================
# Anvukta Consulting Service — environment configuration
# Copy to .env and fill in. Never commit .env.
# =============================================================================

# --- Database ----------------------------------------------------------------
# SQLite file path, relative to the project root.
# To move to PostgreSQL: change the datasource provider in prisma/schema.prisma,
# swap the adapter in src/lib/db.ts, and set a postgresql:// URL here.
DATABASE_URL="file:./dev.db"

# --- Security ----------------------------------------------------------------
# Used to salt the client fingerprint that backs rate limiting.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="replace-with-a-64-character-random-string"

# --- Demo mode ---------------------------------------------------------------
# Set to "true" while sharing a test link (for example a Cloudflare tunnel).
# Every page then asks search engines to stay away, robots.txt disallows
# everything and the sitemap is empty. Read at build time as well as at request
# time, so rebuild after changing it. Leave unset for the real launch.
DEMO_MODE=""

# --- Abuse control -----------------------------------------------------------
# Set to "true" ONLY when a proxy you control sits in front of this app and
# overwrites X-Forwarded-For (nginx, Caddy, Cloudflare, a load balancer).
# Left unset, the header is ignored, because anyone can send any value in it and
# would otherwise get a fresh rate-limit allowance on every request. Visitors are
# then identified by a signed cookie this server issues, backed by a site-wide
# ceiling that no amount of switching identities can get past.
TRUST_PROXY_HEADERS=""

# --- Site --------------------------------------------------------------------
# Canonical origin, no trailing slash. Drives canonicals, sitemap, OG tags.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- First admin account -----------------------------------------------------
# Read only by prisma/seed.ts. Change the password before any real deployment.
# Re-seeding never overwrites an existing account's password.
ADMIN_EMAIL="admin@anvukta.example"
ADMIN_PASSWORD="ChangeMe!Admin2026"
# Shown publicly as the byline on articles, so use the firm or a real person.
ADMIN_NAME="Anvukta Consulting Service"

# --- Public contact details (optional) ---------------------------------------
# Placeholders are used when these are unset. Set them before launch.
NEXT_PUBLIC_CONTACT_EMAIL="contact@anvukta.com"
NEXT_PUBLIC_CONTACT_PHONE=""
# Pipe-separated address lines, e.g. "Level 12, Tower A|Dubai|United Arab Emirates"
NEXT_PUBLIC_CONTACT_ADDRESS=""
NEXT_PUBLIC_CONTACT_REGION="GCC"

# --- Social profiles (optional) ----------------------------------------------
# Left blank, the links and the sameAs structured-data entries are omitted.
NEXT_PUBLIC_SOCIAL_LINKEDIN=""
NEXT_PUBLIC_SOCIAL_X=""

# --- Contact notification email (optional) -----------------------------------
# Leave unset and submissions are still stored; no email is sent and the site
# never claims one was. Set all four to enable notifications.
# Requires: npm install nodemailer
SMTP_HOST=""
SMTP_PORT=""
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM=""
CONTACT_NOTIFICATION_TO=""
